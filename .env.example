# NewsData.io — free tier: 200 credits/day, commercial use allowed.
# Sign up: https://newsdata.io/register
NEWSDATA_API_KEY=

# The Guardian — free, no commercial-use restriction.
# Sign up: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# GNews — free tier: 100 requests/day.
# Sign up: https://gnews.io/register
GNEWS_API_KEY=

# NYTimes — free tier, generous daily quota.
# Sign up: https://developer.nytimes.com/
NYTIMES_API_KEY=

# Google News (RSS) and Hacker News need no key — they're on by default.

# --- Web build only (server/, and the frontend's VITE_* build-time vars) ------------------------
# The desktop app is fully local and reads none of these.

# Postgres connection string (Supabase). Must use the session-mode pooler, port 5432, not the 6543
# transaction pooler — transaction mode can't run `prisma db push`. There is no separate dev
# database for this project: this always points at the real, live database.
DATABASE_URL=

# Comma-separated list of exact website origins allowed to call the API (e.g. the Vercel site's
# address). Falls back to localhost dev origins when unset — see server/index.ts.
ALLOWED_ORIGINS=

# Google OAuth Client ID (Google Cloud Console → Credentials → OAuth 2.0 Client ID, type "Web
# application", Authorized JavaScript origins set to the deployed site + localhost:5173/5174 — no
# redirect URI needed, sign-in never redirects). NOT a secret; used both server-side (as the
# verifyIdToken audience) and by the frontend as VITE_GOOGLE_CLIENT_ID (same value, both required).
# The server refuses to boot without this — see server/index.ts.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Daily per-guest search cap before the "resets in..." message kicks in — see
# server/stores/providerBudget.ts. The founder's own (isOwner) account is never subject to this.
# GUEST_DAILY_SEARCH_CAP=1500

# Gemini (Google AI Studio) — powers AI relevance filtering. When set, freshly-fetched stories are
# run past the model to drop tangential/wrong-sense results the keyword heuristic can't catch; when
# unset, the app silently uses the free keyword heuristic only. Free tier is generous for this.
# NOTE: Gemini's FREE tier may use submitted data (article titles/snippets) to improve Google's
# products. The paid tier — and the future Claude Haiku path — do not.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# AI_DAILY_CAP=3000

# Resend — sends the daily digest email (server/digest/email.ts). Free tier: 3,000/month, 100/day.
# Requires usecatchup.app to be verified as a sending domain in the Resend dashboard (SPF/DKIM DNS
# records) before any send will actually succeed.
# Sign up: https://resend.com/signup
RESEND_API_KEY=
