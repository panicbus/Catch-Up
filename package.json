{
  "name": "catch-up",
  "version": "0.15.9",
  "private": true,
  "description": "Your topics. Your pace. All caught up.",
  "author": "Catch Up contributors",
  "main": "dist-electron/main.js",
  "scripts": {
    "compile:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run compile:electron && concurrently -k \"npm run watch:electron\" \"vite\" \"wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.js && ELECTRON_IS_DEV=1 electron .\"",
    "watch:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json && vite build && npm run compile:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:mac": "bash scripts/build-icon.sh",
    "pack:mac:dir": "npm run build && CSC_IDENTITY_AUTO_SELECT=false electron-builder --mac --dir --arm64",
    "release:mac": "node scripts/make-packaged-env.mjs && npm run build && electron-builder --mac --publish never",
    "start": "npm run build && electron .",
    "app": "electron .",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "rss-parser": "^3.13.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "husky": "^9.1.7",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.catchup.app",
    "productName": "Catch Up",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "afterPack": "buildResources/afterPack.js",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "packaged.env",
        "to": "packaged.env"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.news",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "buildResources/entitlements.mac.plist",
      "entitlementsInherit": "buildResources/entitlements.mac.plist",
      "notarize": {
        "teamId": "KB8N3Q3ZAF"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    }
  }
}
