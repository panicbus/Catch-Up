# NewsData.io — free tier: 200 credits/day, commercial use allowed.
# Sign up: https://newsdata.io/register
NEWSDATA_API_KEY=

# The Guardian — free, no commercial-use restriction.
# Sign up: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# GNews — free tier: 100 requests/day.
# Sign up: https://gnews.io/register
GNEWS_API_KEY=

# NYTimes — free tier, generous daily quota.
# Sign up: https://developer.nytimes.com/
NYTIMES_API_KEY=

# Google News (RSS) and Hacker News need no key — they're on by default.

# Gemini (Google AI Studio) — powers AI relevance filtering. When set, freshly-fetched stories are
# run past the model to drop tangential/wrong-sense results the keyword heuristic can't catch; when
# unset, the app silently uses the free keyword heuristic only. Free tier is generous for this.
# NOTE: Gemini's FREE tier may use submitted data (article titles/snippets) to improve Google's
# products. The paid tier — and the future Claude Haiku path — do not.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# AI_DAILY_CAP=3000
