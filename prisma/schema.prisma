// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every table below is scoped by userId from day one — that was true before real sign-in existed
// (only the founder's row) and is what made adding Google sign-in a change to how a request
// resolves its acting user, not a reshaping of any of this.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String?  @map("display_name")
  passwordHash String?  @map("password_hash") // unused — sign-in is Google-only, no local passwords
  authProvider String?  @map("auth_provider") // 'google' for every account created by sign-in
  googleId     String?  @unique @map("google_id") // Google's stable `sub` claim
  avatarUrl    String?  @map("avatar_url") // Google profile picture, shown by the account menu
  // NOT vestigial: this is the usage-cap exemption flag. The founder's own account is never
  // counted or capped (see server/stores/providerBudget.ts), so guests sharing the app can't
  // consume the shared news-provider quotas out from under it. Deliberately never written by the
  // sign-in upsert — signing in must never be able to demote the owner.
  isOwner      Boolean  @default(false) @map("is_owner")
  createdAt    DateTime @default(now()) @map("created_at")

  channels               Channel[]
  subchannels            Subchannel[]
  articles               Article[]
  readStates             ReadState[]
  bookmarks              Bookmark[]
  settings               Settings?
  streak                 Streak?
  sessions               Session[]
  classificationVerdicts ClassificationCache[]
  classificationBudgets  ClassificationDailyBudget[]
  providerBudgets        ProviderDailyBudget[]
  customSources          CustomSource[]

  @@map("users")
}

// One row per live sign-in. `id` is the sha256 hash of the random token held in the session
// cookie — never the token itself, so a leaked backup or a stray log line yields unusable hashes
// rather than working sessions. Rows are real, so a session can be revoked instantly by deleting
// one (which is what signing out does), unlike a stateless token that stays valid until it expires.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Channel {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  slug        String
  sortOrder   Int       @map("sort_order")
  pausedUntil DateTime? @map("paused_until")
  pausedLabel String?   @map("paused_label")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subchannels Subchannel[]
  articles    Article[]
  bookmarks   Bookmark[]
  verdicts    ClassificationCache[]

  @@unique([userId, slug])
  @@map("channels")
}

model Subchannel {
  id        String   @id @default(uuid())
  channelId String   @map("channel_id")
  userId    String   @map("user_id") // denormalized for direct scoping, same pattern as every other table
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles Article[]

  @@map("subchannels")
}

model Article {
  // Keep the existing hash-of-url id (providers/dedupe.ts's articleId()) as the identifier rather
  // than inventing a new surrogate key — but the REAL primary key is (channelId, id), not id
  // alone: the same real-world story can legitimately be picked up by more than one channel's own
  // search (e.g. a wire story matching both a "Tech" and a "Politics" channel) and needs its own
  // row in each — confirmed against real migrated data, not theoretical (19 real articles existed
  // in two channels each before this was caught).
  id             String
  channelId      String   @map("channel_id")
  subchannelId   String?  @map("subchannel_id")
  userId         String   @map("user_id")
  url            String
  title          String
  snippet        String?
  source         String
  sourceDomain   String   @map("source_domain")
  imageUrl       String?  @map("image_url")
  publishedAt    DateTime @map("published_at")
  fetchedAt      DateTime @map("fetched_at")
  provider       String
  paywalled      Boolean  @default(false)
  titleDedupeKey String   @map("title_dedupe_key")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  subchannel Subchannel? @relation(fields: [subchannelId], references: [id], onDelete: SetNull)

  @@id([channelId, id])
  @@index([userId, channelId, publishedAt(sort: Desc)])
  @@index([userId, channelId, titleDedupeKey])
  @@map("articles")
}

model ReadState {
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  readAt    DateTime @default(now()) @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@map("read_state")
}

model Bookmark {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  channelId       String   @map("channel_id")
  subchannelId    String?  @map("subchannel_id")
  articleId       String   @map("article_id")
  bookmarkedAt    DateTime @default(now()) @map("bookmarked_at")
  articleSnapshot Json     @map("article_snapshot") // same denormalized point-in-time snapshot as today

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("bookmarks")
}

model Settings {
  userId                 String    @id @map("user_id")
  defaultViewMode        String    @default("list") @map("default_view_mode")
  refreshIntervalMinutes Int       @default(30) @map("refresh_interval_minutes")
  theme                  String    @default("light")
  rollTheDiceChannelIds  String[]  @map("roll_the_dice_channel_ids")
  maxStoriesShown        Int       @default(25) @map("max_stories_shown")
  homeLocation           Json?     @map("home_location") // {query,label,lat,lon} or null, same shape as AppSettings today
  aiEnabled              Boolean   @default(false) @map("ai_enabled") // legacy pre-provider-choice flag; see aiProvider
  aiApiKey               String?   @map("ai_api_key") // Gemini key; never sent to the frontend; same guarantee as dataStore.ts today
  aiProvider             String?   @map("ai_provider") // 'gemini' | 'groq' | 'ollama' | null (off); null on rows saved before providers existed — getAiProvider() falls back to aiEnabled+aiApiKey for those
  groqApiKey             String?   @map("groq_api_key") // never sent to the frontend, same guarantee as aiApiKey
  ollamaModel            String    @default("qwen2.5:7b") @map("ollama_model") // desktop-meaningful only
  onboardingCompleted    Boolean   @default(false) @map("onboarding_completed")
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// A user's own added news source (a feed URL they pasted in Settings) — global to the account, not
// scoped to one channel, since a source like ProPublica or AP isn't specific to any single topic.
// Every channel's own relevance gate decides what (if anything) from it actually fits — see
// main/providers/relevance.ts's FALLBACK_PROVIDER-style strict handling, extended to cover these.
model CustomSource {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  feedUrl             String    @map("feed_url") // the resolved, actually-parseable feed URL
  siteUrl             String    @map("site_url") // what the user actually pasted, for display
  label               String // from the feed's own <title> at add time; user-editable after
  createdAt           DateTime  @default(now()) @map("created_at")
  lastFetchedAt        DateTime? @map("last_fetched_at") // drives the ~hourly throttle
  // Conditional-GET validators from the last successful fetch — lets a re-check skip the download
  // entirely (a 304) when the feed hasn't changed, which is the common case for a once-an-hour poll.
  etag                 String?   @map("etag")
  lastModified         String?   @map("last_modified")
  consecutiveFailures  Int       @default(0) @map("consecutive_failures")
  lastError            String?   @map("last_error")
  disabledAt           DateTime? @map("disabled_at") // null = active; set after repeated failures

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feedUrl])
  @@map("custom_sources")
}

model Streak {
  userId           String    @id @map("user_id")
  current          Int       @default(0)
  lastCaughtUpDate DateTime? @map("last_caught_up_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// Verdicts are cached per (user, channel, article) — NOT per article alone: the same URL can
// legitimately be relevant in one channel and not another (confirmed against main/aiRelevance.ts,
// whose cache key is already `${channelId}:${id}`, not just `id`).
model ClassificationCache {
  userId       String   @map("user_id")
  channelId    String   @map("channel_id")
  articleId    String   @map("article_id")
  keep         Boolean
  classifiedAt DateTime @default(now()) @map("classified_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId, articleId])
  @@map("classification_cache")
}

model ClassificationDailyBudget {
  userId String   @map("user_id")
  date   DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("classification_daily_budget")
}

// Same shape and same reasoning as ClassificationDailyBudget above, for a different metered
// resource: the news-provider fetches (NewsData/Guardian/GNews/NYTimes). Those API keys are
// app-level and SHARED across every account, so without a per-account ceiling a handful of guests
// could exhaust the day's quota for everyone. Rows are only ever written for non-owner accounts —
// the founder's own usage is never counted (see server/stores/providerBudget.ts), which is what
// keeps sharing the app from degrading the founder's own use of it.
//
// `date` is a UTC DATE, so the budget resets at midnight UTC — that's what the "resets in ..."
// message shown to a capped guest is computed from.
model ProviderDailyBudget {
  userId String   @map("user_id")
  date   DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("provider_daily_budget")
}
