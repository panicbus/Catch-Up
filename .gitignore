node_modules
dist
dist-electron
dist-server
release
.DS_Store
*.log

# Local Claude Code harness settings (machine/session-specific)
.claude/settings.local.json

# Local-only Claude Code skills (not shared via the repo)
.claude/skills/

# Local data (JSON stores) and secrets. Anchored to the repo root (`/data/`, not `data/`) so it
# doesn't also match main/data/ — the bundled, committed gazetteer asset used by main/locality/.
/data/
.env
.env.*
!.env.example
# Provider keys bundled into a packaged build (generated from .env at release time)
packaged.env

# Generated database client (build output, not source) — lives under server/, never under src/,
# since the browser-side app must never bundle a database driver.
/server/generated/prisma
